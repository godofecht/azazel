#!/usr/bin/env python3
"""Azazel CLI: validate, generate, build, inspect, and clean an Azazel project.

The CUE -> Zig generator has exactly one implementation: gen_build_spec.sh.
This CLI orchestrates that canonical pipeline; it does not reimplement it.
"""

from __future__ import annotations

import json
import shutil
import subprocess
import sys
from pathlib import Path

REQUIRED_MODULE_FIELDS = {
    "kind",
    "artifact_name",
    "root",
    "deps",
    "link",
    "pre",
    "post",
    "install_dirs",
    "pkg_library_paths",
    "pkg_imports",
    "pkg_artifacts",
    "build_options",
    "option_values",
    "gen_imports",
    "build_options_import",
    "native",
    "optimize",
}


def project_root() -> Path | None:
    current = Path.cwd().resolve()
    for candidate in (current, *current.parents):
        if (candidate / "schema.cue").is_file() and (candidate / "gen_build_spec.sh").is_file():
            return candidate
    return None


def require_tool(name: str) -> None:
    if shutil.which(name) is None:
        raise RuntimeError(f"required tool not found on PATH: {name}")


def run(args: list[str], *, cwd: Path, capture: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        cwd=cwd,
        text=True,
        capture_output=capture,
        check=False,
    )


def cue_export(root: Path) -> dict:
    require_tool("cue")
    result = run(["cue", "export", "-e", "build"], cwd=root)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "cue export failed")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"cue export returned invalid JSON: {exc}") from exc


def validate_graph(data: dict, root: Path) -> list[str]:
    errors: list[str] = []
    modules = data.get("modules")
    if not isinstance(modules, dict) or not modules:
        return ["build.modules must contain at least one module"]

    names = set(modules)
    graph: dict[str, list[str]] = {}

    for name, module in modules.items():
        if not isinstance(module, dict):
            errors.append(f"module {name!r} did not export as an object")
            continue

        missing = sorted(REQUIRED_MODULE_FIELDS - set(module))
        if missing:
            errors.append(f"module {name!r} is missing exported fields: {', '.join(missing)}")

        source = module.get("root")
        if isinstance(source, str) and not (root / source).is_file():
            errors.append(f"module {name!r} root does not exist: {source}")

        deps = module.get("deps", [])
        if not isinstance(deps, list):
            errors.append(f"module {name!r} deps did not export as a list")
            deps = []
        graph[name] = [dep for dep in deps if isinstance(dep, str)]
        for dep in graph[name]:
            if dep not in names:
                errors.append(f"module {name!r} depends on unknown module {dep!r}")
            elif dep == name:
                errors.append(f"module {name!r} depends on itself")

    state: dict[str, int] = {}

    def visit(node: str, trail: list[str]) -> None:
        mark = state.get(node, 0)
        if mark == 2:
            return
        if mark == 1:
            cycle = trail[trail.index(node):] + [node] if node in trail else trail + [node]
            errors.append("dependency cycle: " + " -> ".join(cycle))
            return
        state[node] = 1
        for dep in graph.get(node, []):
            if dep in graph:
                visit(dep, trail + [node])
        state[node] = 2

    for name in graph:
        if state.get(name, 0) == 0:
            visit(name, [])

    return errors


def cmd_check(root: Path) -> int:
    data = cue_export(root)
    errors = validate_graph(data, root)
    if errors:
        for error in errors:
            print(f"error: {error}", file=sys.stderr)
        return 1
    print(f"azazel: configuration valid ({len(data['modules'])} modules)")
    return 0


def cmd_gen(root: Path) -> int:
    result = run(["sh", "gen_build_spec.sh"], cwd=root, capture=False)
    return result.returncode


def cmd_build(root: Path, extra: list[str]) -> int:
    if cmd_check(root) != 0:
        return 1
    if cmd_gen(root) != 0:
        return 1
    require_tool("zig")
    result = run(["zig", "build", *extra], cwd=root, capture=False)
    return result.returncode


def cmd_clean(root: Path) -> int:
    for name in ("build_spec.zig", ".build_spec.stamp"):
        path = root / name
        if path.exists():
            path.unlink()
    for pattern in ("zig-out", ".zig-cache", "zig-cache", ".zig-cache-*", ".zig-cache-global-*"):
        for path in root.glob(pattern):
            if path.is_dir():
                shutil.rmtree(path)
    return 0


def cmd_info(root: Path) -> int:
    print(json.dumps(cue_export(root), indent=2, sort_keys=True))
    return 0


def usage() -> None:
    print(
        "azazel — deterministic CUE + Zig build configuration\n\n"
        "usage:\n"
        "  azazel check\n"
        "  azazel gen\n"
        "  azazel build [zig build args...]\n"
        "  azazel clean\n"
        "  azazel info"
    )


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        usage()
        return 0

    root = project_root()
    if root is None:
        print("error: not inside an Azazel project (schema.cue + gen_build_spec.sh not found)", file=sys.stderr)
        return 1

    command, rest = args[0], args[1:]
    try:
        if command == "check":
            return cmd_check(root)
        if command == "gen":
            return cmd_gen(root)
        if command == "build":
            return cmd_build(root, rest)
        if command == "clean":
            return cmd_clean(root)
        if command == "info":
            return cmd_info(root)
        print(f"error: unknown command: {command}", file=sys.stderr)
        usage()
        return 2
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
